# ── Database ─────────────────────────────────────────────────────
# Get this from MongoDB Atlas → R──
# Replace <username> and <password> with your Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stencil-oms?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────────
# Use a long random string (32+ characters). Keep this secret!
# Generate one at: https://randomkeygen.com
JWT_SECRET=change-this-to-a-long-random-secret-key-minimum-32-chars
JWT_EXPIRES_IN=7d

# ── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── CORS ─────────────────────────────────────────────────────────
# Your Vercel frontend URL. For multiple URLs, comma-separate them:
# FRONTEND_URL=https://your-app.vercel.app,https://custom-domain.com
FRONTEND_URL=https://your-vercel-app.vercel.app
